.DS_Store
Thumbs.db
*~
*.swp

# Python tooling used by tools/ scripts
.venv/
__pycache__/
*.pyc

# tools/mock_server.py keeps its fake accounts here
tools/.mock_state.json

# Local credentials — never commit these
secrets/
*.secret.json
.env
.env.*
!env.sample
