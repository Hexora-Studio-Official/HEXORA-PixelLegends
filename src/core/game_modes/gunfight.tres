[gd_resource type="Resource" script_class="GameMode" load_steps=2 format=3]

; 2v2, mirrored random loadouts each round. No respawns.
;
; Hand-authored data resource — safe to edit in the Godot inspector, but keep the
; localisation keys in sync with src/i18n/strings_*.gd.

[ext_resource type="Script" path="res://src/core/game_mode.gd" id="1_gamemode"]

[resource]
script = ExtResource("1_gamemode")

id = &"gunfight"
category = &"core"
title_key = &"mode.gunfight.name"
short_key = &"mode.gunfight.short"
description_key = &"mode.gunfight.desc"
rules_key = &"mode.gunfight.rules"
icon_kind = &"mode_gunfight"
accent = Color(1, 0.498039, 0.643137, 1)
sort_index = 40
min_players = 2
max_players = 4
teams = 2
team_size = 2
supports_bots = true
score_limit = 6
time_limit_sec = 600.0
round_based = true
rounds_to_win = 6
round_time_sec = 60.0
respawn_enabled = false
respawn_delay = 0.0
friendly_fire = false
warmup_sec = 10.0
revive_enabled = false
loadout_editable_ingame = false
is_battle_royale = false
squad_size = 1
zone_phases = 0
loot_tier = 1
drop_from_plane = false
in_matchmaking = true
ranked = false
supports_lan = true
