; PixelLegends — engine configuration
;
; Engine version target: Godot 4.4.
; Renderer: "mobile" — the sweet spot for the art direction we want:
; dynamic lights + shadows + PBR materials without the Forward+ desktop cost.
;
; NOTE: this project deliberately keeps almost all configuration in code
; (autoloads + data resources) so that the repository stays readable in a
; diff and so that gameplay rules are never hidden in an editor-only file.

config_version=5

[application]

config/name="PixelLegends"
config/description="PixelLegends is an original pixel-art 5v5 MOBA. This Godot 4.4 project is currently focused on its visual client shell and product documentation; gameplay and server features are planned, not implemented."
config/version="0.1.0"
run/main_scene="res://src/ui/screens/boot_screen.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://assets/Pixel Legends_ 5v5 Showdown.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.035294, 0.101961, 0.164706, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=true

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

; Load order matters: each service may only depend on services above it.
;
; Every entry below serves the current PixelLegends client shell. The earlier
; shooter-era services (a generic HTTP API client, friends, LAN/online rooms
; and matchmaking) were removed rather than left dormant: they described a
; different game, and docs/PROJECT_SPEC.txt defines the backend and match
; architecture that a future approved phase must build instead.
;
; Controls is the input/touch-feedback service for the shell; it is not an
; approved MOBA control scheme.
; Auth supports local Guest entry only. It is not Nakama authentication, and
; the Google path is not implemented.
EventBus="*res://src/autoload/event_bus.gd"
Settings="*res://src/autoload/settings_service.gd"
Loc="*res://src/autoload/loc.gd"
Design="*res://src/autoload/design.gd"
Controls="*res://src/autoload/controls.gd"
Session="*res://src/autoload/session.gd"
Audio="*res://src/autoload/audio_service.gd"
Auth="*res://src/autoload/auth_service.gd"
Toasts="*res://src/autoload/toasts.gd"
Router="*res://src/autoload/router.gd"

[debug]

; A GDScript warning is never noise in a project this size, but treating them as
; errors would block iteration in the editor, so they stay warnings.
gdscript/warnings/untyped_declaration=1
file_logging/enable_file_logging=true
settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[file_customization]

; Editor-only, purely cosmetic: it keeps the FileSystem dock readable.
folder_colors={
"res://assets/": "orange",
"res://docs/": "gray",
"res://src/autoload/": "green",
"res://src/core/": "purple",
"res://src/ui/": "yellow",
"res://tools/": "gray"
}

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

; The in-game string table is English-only; no locale translations are imported.
locale/fallback="en"
locale/test="en"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_physics/layer_5="interactable"
3d_physics/layer_6="npc_bot"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"
3d_render/layer_3="ui_world"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=16.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.027451, 0.0431373, 0.0666667, 1)
environment/defaults/default_environment="res://assets/art/default_environment.tres"
occlusion_culling/use_occlusion_culling=true
