; HEXORA — engine configuration
;
; Engine version target: Godot 4.4+ (forward compatible with 4.5 / 4.6 / 4.7).
; Renderer: "mobile" — the sweet spot for the art direction we want:
; dynamic lights + shadows + PBR materials without the Forward+ desktop cost.
;
; NOTE: this project deliberately keeps almost all configuration in code
; (autoloads + data resources) so that the repository stays readable in a
; diff and so that gameplay rules are never hidden in an editor-only file.

config_version=5

[application]

config/name="HEXORA"
config/description="HEXORA — tactical online 3D shooter (Android / desktop).
Team Deathmatch, Search & Destroy, Free For All and Battle Royale 30/50/100.
Play online, in private rooms, or over a phone hotspot with no internet at all."
config/version="0.1.0"
run/main_scene="res://src/ui/screens/boot_screen.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.027451, 0.0431373, 0.0666667, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=true

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

; Load order matters: each service may only depend on services above it.
;   EventBus   — no dependencies at all, everything else emits through it.
;   Settings   — owns user://settings.cfg, needs nothing.
;   Loc        — reads the language setting from Settings.
;   Design     — builds the Theme, reads the HUD scale from Settings.
;   Controls   — registers InputMap actions, reads the controls section.
;   Session    — the signed-in profile + local stats persistence.
;   Audio      — bus volumes, music, procedural UI cues.
;   Api        — HTTP transport for everything online.
;   Auth       — Google Sign-In and guest accounts, talks to Api + Session.
;   Friends    — friends, party and invitations.
;   Rooms      — custom lobbies, LAN/hotspot discovery, host & join.
;   Matchmaking— the random competitive queue.
;   Toasts     — transient UI messages (needs Design).
;   Router     — screen navigation, must be able to see every screen path.
EventBus="*res://src/autoload/event_bus.gd"
Settings="*res://src/autoload/settings_service.gd"
Loc="*res://src/autoload/loc.gd"
Design="*res://src/autoload/design.gd"
Controls="*res://src/autoload/controls.gd"
Session="*res://src/autoload/session.gd"
Audio="*res://src/autoload/audio_service.gd"
Api="*res://src/autoload/api_client.gd"
Auth="*res://src/autoload/auth_service.gd"
Friends="*res://src/autoload/friends_service.gd"
Rooms="*res://src/autoload/room_service.gd"
Matchmaking="*res://src/autoload/matchmaking.gd"
Toasts="*res://src/autoload/toasts.gd"
Router="*res://src/autoload/router.gd"

[debug]

; A GDScript warning is never noise in a project this size, but treating them as
; errors would block iteration in the editor, so they stay warnings.
gdscript/warnings/untyped_declaration=1
file_logging/enable_file_logging=true
settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[file_customization]

; Editor-only, purely cosmetic: it keeps the FileSystem dock readable.
folder_colors={
"res://assets/": "orange",
"res://docs/": "gray",
"res://src/autoload/": "green",
"res://src/core/": "purple",
"res://src/net/": "blue",
"res://src/ui/": "yellow",
"res://tools/": "gray"
}

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

; Source of truth is src/i18n/strings_*.gd; LocalizationService builds the
; Translation objects at runtime, so no `locale/translations` list is needed.
; `fa` is wired as the test locale so RTL layout can be previewed in-editor.
locale/fallback="en"
locale/test="fa"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_physics/layer_5="interactable"
3d_physics/layer_6="npc_bot"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"
3d_render/layer_3="ui_world"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=16.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.027451, 0.0431373, 0.0666667, 1)
environment/defaults/default_environment="res://assets/art/default_environment.tres"
occlusion_culling/use_occlusion_culling=true
